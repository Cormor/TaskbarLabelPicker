        "stiffness": 400,
        "dampingRatio": 1
      },
      "expressive": {
        "mass": 1,
        "stiffness": 225,
        "dampingRatio": 0.85
      }
    },
    "rest": {
      "displacement": 0.001,
      "speed": 0.001
    },
    "reduced": "Set target immediately and clear velocity; react to preference changes during motion"
